# AGI-1's live show: the settings file on the owner's server. Copy it to /opt/agi1-live/live.env there and fill it in:
#   cp tools/live/live.env.example /opt/agi1-live/live.env && chmod 600 /opt/agi1-live/live.env && nano /opt/agi1-live/live.env
# NEVER put the filled-in file in git, a chat or a screenshot: it has secrets (LIVE_SECRET, the stream key).
# One setting a line, NAME=value, with no quotes and no spaces around "=".

# the site, and the same LIVE_SECRET as in Vercel (32+ random characters). www: agi1.app redirects there, and the show
# never follows a redirect with its key (2026-10-06, the first real setup: with agi1.app here, --check said so)
SITE_URL=https://www.agi1.app
LIVE_SECRET=

# X Live Studio → Sources → your source: its server address (RTMP or RTMPS URL) and its stream key
LIVE_RTMP_URL=
LIVE_STREAM_KEY=

# her voice: Google Cloud. A service account's key file, saved on the server as /opt/agi1-live/google-key.json
# (tools/live/live.sh hands it to the show at this place)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-key.json
# …or an API key instead of the key file (Google Cloud → APIs & Services → Credentials), restricted to the "Agent Platform
# API" (formerly "Vertex AI API"):
# LIVE_GCP_API_KEY=
# where Google makes her voice ("global" works for most projects) and the model (the same one as the site's)
LIVE_VERTEX_LOCATION=global
LIVE_VOICE_MODEL=gemini-3.8-flash-lite-tts
# the order to try her voice in: vertex, cloud (Cloud Text-to-Speech), gemini (the site's own key: shares the site's
# daily limit, so only as a backup; then also set GEMINI_API_KEY)
LIVE_VOICES=vertex
# GEMINI_API_KEY=

# how long a show is (minutes), and when it starts every day (HH:MM, UTC: "sh tools/live/live.sh show" waits for it, and
# agi1.app/live says it when a show ends). The cron line starts the show 2 minutes before this time: change both together
# (01:00 UTC, the owner's choice on 2026-10-03: 9 AM the owner's time, the evening in the US)
LIVE_MINUTES=60
LIVE_DAILY_AT=01:00

# her mouth vs her voice (ms): run "sh tools/live/live.sh --sync-check" once on the server and use the number it says
LIVE_AV_MS=170

# her music: her own songs, made in code (tools/live/music.js), quiet under her voice. off to switch it off; the volume in
# percent (100 = as made; 50 = quieter, 150 = louder)
LIVE_MUSIC=on
LIVE_MUSIC_VOLUME=100

# optional, for how smoothly she moves on a small server (leave them out: the show picks them by the server's cores).
# LIVE_GL: how many pixels her picture draws for every 720 of the set (720 with 4 cores or more, else 540; 480 draws faster
# and looks a little softer). LIVE_X264_PRESET: how hard the video encoder works (superfast below 4 cores, else veryfast)
# LIVE_GL=540
# LIVE_X264_PRESET=superfast
