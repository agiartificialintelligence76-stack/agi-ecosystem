# TRENCHING SIMULATOR's Live mode relay: its settings file on the owner's server. Copy it to /opt/agi1-trench/trench.env
# there (chmod 600). NEVER put the filled-in file in git, a chat or a screenshot: it has the Helius key.
# One setting a line, NAME=value, with no quotes and no spaces around "=".

# Helius (Solana's live bonding curves; the free plan is enough): the API key from dashboard.helius.dev (API Keys), or the
# whole RPC address with "api-key=" in it. Put it in with the hidden line in the owner's steps (read -s …), never where it
# shows on screen.
HELIUS_API_KEY=

# the site's own pages that may connect (their Origin), comma-separated
TRENCH_ORIGINS=https://agi1.app,https://www.agi1.app

# Caddy, in front, says who's connecting: trust it (the relay's own port is never open to the internet)
TRENCH_TRUST_PROXY=1

# its caps: viewers at once, and from one address at once
TRENCH_MAX_CLIENTS=2000
TRENCH_MAX_PER_IP=10

# its chains: solana (pump.fun; needs Helius), robinhood (clank.trade), bnb, base, and since 2026-10-22 GMGN's others:
# ethereum, monad, hyperevm, arbitrum, tron (DexScreener's listed coins, no key)
TRENCH_CHAINS=solana,robinhood,bnb,base,ethereum,monad,hyperevm,arbitrum,tron

# the newest pump.fun coins followed live, and the coins viewers have open or hold, followed on top of those (together at
# most 950: Helius allows 1,000 a connection)
TRENCH_SOLANA_TRACK=150
TRENCH_WATCH_MAX=150

# the pictures kept in memory (MB)
TRENCH_PIC_CACHE_MB=64

# its log: debug, info, warn or error
TRENCH_LOG=info

# race rooms (wss://live.agi1.app/room, since 2026-10-22): on unless TRENCH_ROOMS=off; seats a room, rooms at once, racers
# at once, and racers from one address at once
# TRENCH_ROOMS=off
# TRENCH_ROOM_SEATS=8
# TRENCH_ROOMS_MAX=200
# TRENCH_ROOM_PLAYERS=1600
# TRENCH_ROOMS_PER_IP=8

# its sources (leave them as they are): PumpPortal's free WebSocket (PUMPPORTAL_WS_URL=off: PumpDev alone, from the
# start), PumpDev's (the backup; off to switch it off), DexScreener, clank.trade's API, the public IPFS gateways (in this
# order)
# PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# PUMPDEV_WS_URL=wss://pumpdev.io/ws
# DEXSCREENER_URL=https://api.dexscreener.com
# CLANK_API_URL=https://clank.trade/v1/trpc/
# TRENCH_IPFS_GATEWAYS=https://ipfs.filebase.io/ipfs/,https://gateway.pinata.cloud/ipfs/,https://ipfs.io/ipfs/
