{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/launch/:draft", "destination": "/launch" },
    { "source": "/studio/:path+", "destination": "/studio" },
    { "source": "/talk", "destination": "/" },
    { "source": "/talk/", "destination": "/" },
    { "source": "/games/rideemagi", "destination": "/rideemagi" },
    { "source": "/games/rideemagi/", "destination": "/rideemagi" },
    { "source": "/games/trenchingsimulator", "destination": "/trenchingsimulator" },
    { "source": "/games/trenchingsimulator/", "destination": "/trenchingsimulator" },
    { "source": "/games/vladrunner2049", "destination": "/vladrunner2049" },
    { "source": "/games/vladrunner2049/", "destination": "/vladrunner2049" },
    { "source": "/games/skybreak", "destination": "/skybreak" },
    { "source": "/games/skybreak/", "destination": "/skybreak" },
    { "source": "/games/mergeagi", "destination": "/mergeagi" },
    { "source": "/games/mergeagi/", "destination": "/mergeagi" },
    { "source": "/games/blockchain", "destination": "/blockchain" },
    { "source": "/games/blockchain/", "destination": "/blockchain" },
    { "source": "/games/heartbeat", "destination": "/heartbeat" },
    { "source": "/games/heartbeat/", "destination": "/heartbeat" },
    { "source": "/games/scamslayer", "destination": "/scamslayer" },
    { "source": "/games/scamslayer/", "destination": "/scamslayer" },
    { "source": "/games/lastmodel", "destination": "/lastmodel" },
    { "source": "/games/lastmodel/", "destination": "/lastmodel" },
    { "source": "/games/singularity", "destination": "/singularity" },
    { "source": "/games/singularity/", "destination": "/singularity" },
    { "source": "/games/jailbreak", "destination": "/jailbreak" },
    { "source": "/games/jailbreak/", "destination": "/jailbreak" },
    { "source": "/games/stacked", "destination": "/stacked" },
    { "source": "/games/stacked/", "destination": "/stacked" },
    { "source": "/games/jaywalk", "destination": "/jaywalk" },
    { "source": "/games/jaywalk/", "destination": "/jaywalk" },
    { "source": "/games/robotaxi", "destination": "/robotaxi" },
    { "source": "/games/robotaxi/", "destination": "/robotaxi" },
    { "source": "/games/realorai", "destination": "/realorai" },
    { "source": "/games/realorai/", "destination": "/realorai" },
    { "source": "/games/notarobot", "destination": "/notarobot" },
    { "source": "/games/notarobot/", "destination": "/notarobot" },
    { "source": "/games/alignment", "destination": "/alignment" },
    { "source": "/games/alignment/", "destination": "/alignment" },
    { "source": "/games/gradient", "destination": "/gradient" },
    { "source": "/games/gradient/", "destination": "/gradient" },
    { "source": "/games/epochs", "destination": "/epochs" },
    { "source": "/games/epochs/", "destination": "/epochs" },
    { "source": "/games/synapse", "destination": "/synapse" },
    { "source": "/games/synapse/", "destination": "/synapse" },
    { "source": "/games/overclock", "destination": "/overclock" },
    { "source": "/games/overclock/", "destination": "/overclock" },
    { "source": "/games/beattheagi", "destination": "/beattheagi" },
    { "source": "/games/beattheagi/", "destination": "/beattheagi" },
    { "source": "/games/hallucination", "destination": "/hallucination" },
    { "source": "/games/hallucination/", "destination": "/hallucination" },
    { "source": "/games/guardrails", "destination": "/guardrails" },
    { "source": "/games/guardrails/", "destination": "/guardrails" },
    { "source": "/games/bubblesort", "destination": "/bubblesort" },
    { "source": "/games/bubblesort/", "destination": "/bubblesort" },
    { "source": "/games/airgap", "destination": "/airgap" },
    { "source": "/games/airgap/", "destination": "/airgap" },
    { "source": "/games/cookies", "destination": "/cookies" },
    { "source": "/games/cookies/", "destination": "/cookies" },
    { "source": "/games/packetloss", "destination": "/packetloss" },
    { "source": "/games/packetloss/", "destination": "/packetloss" },
    { "source": "/games/autocomplete", "destination": "/autocomplete" },
    { "source": "/games/autocomplete/", "destination": "/autocomplete" },
    { "source": "/games/overthinking", "destination": "/overthinking" },
    { "source": "/games/overthinking/", "destination": "/overthinking" },
    { "source": "/games/growthstock", "destination": "/growthstock" },
    { "source": "/games/growthstock/", "destination": "/growthstock" },
    { "source": "/games/goinglive", "destination": "/goinglive" },
    { "source": "/games/goinglive/", "destination": "/goinglive" },
    { "source": "/vote/owner", "destination": "/vote" },
    { "source": "/vote/owner/", "destination": "/vote" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "studio.agi1.app" }], "destination": "/studio" },
    { "source": "/owner", "destination": "/owner-command" },
    { "source": "/owner/", "destination": "/owner-command" },
    { "source": "/share/meme/:id", "destination": "/api/wallet?meme-share=:id" },
    { "source": "/discord/interactions", "destination": "/api/telegram?discord" },
    { "source": "/discord/verify", "destination": "/verify" },
    { "source": "/discord/verify/", "destination": "/verify" },
    { "source": "/p/:slug", "destination": "/content" },
    { "source": "/p/:slug/", "destination": "/content" }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "inference.agi1.app" }], "destination": "/cloakmesh", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "studio.agi1.app" }], "destination": "/explore", "permanent": false }
  ],
  "functions": {
    "api/feed.js": {
      "maxDuration": 25,
      "includeFiles": "node_modules/@ffmpeg-installer/linux-x64/**"
    },
    "api/**/*.js": {
      "maxDuration": 25
    }
  },
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 3 * * *" },
    { "path": "/api/keepalive", "schedule": "0 11 * * *" },
    { "path": "/api/keepalive", "schedule": "0 19 * * *" },
    { "path": "/api/feed", "schedule": "30 1 * * *" },
    { "path": "/api/feed", "schedule": "30 4 * * *" },
    { "path": "/api/feed", "schedule": "30 7 * * *" },
    { "path": "/api/feed", "schedule": "30 10 * * *" },
    { "path": "/api/feed", "schedule": "30 13 * * *" },
    { "path": "/api/feed", "schedule": "30 16 * * *" },
    { "path": "/api/feed", "schedule": "30 19 * * *" },
    { "path": "/api/feed", "schedule": "30 22 * * *" },
    { "path": "/api/feed", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://cdn.kolscan.io https://live.agi1.app https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/public/agi1-owner-media/; media-src 'self' blob: https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/public/agi1-owner-media/; connect-src 'self' blob: https://api.dexscreener.com wss://live.agi1.app https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/upload/sign/agi1-owner-media/; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), display-capture=(self)"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/cards/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/icons/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/music/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/memes/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/theme.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/games/skybreak/(characters|environment|motions)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    {
      "source": "/assets/spz-worker-(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://cdn.kolscan.io https://live.agi1.app https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/public/agi1-owner-media/; media-src 'self' blob: https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/public/agi1-owner-media/; connect-src 'self' blob: data: https://api.dexscreener.com wss://live.agi1.app https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/upload/sign/agi1-owner-media/; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(games/skybreak/?|skybreak)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://cdn.kolscan.io https://live.agi1.app https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/public/agi1-owner-media/; media-src 'self' blob: https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/public/agi1-owner-media/; connect-src 'self' blob: https://api.dexscreener.com wss://live.agi1.app https://vujaxukucukjxzhcxlea.supabase.co/storage/v1/object/upload/sign/agi1-owner-media/; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
