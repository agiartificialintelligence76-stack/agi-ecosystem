{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/launch/:draft", "destination": "/launch" },
    { "source": "/studio/:path+", "destination": "/studio" },
    { "source": "/talk", "destination": "/" },
    { "source": "/talk/", "destination": "/" },
    { "source": "/games/rideemagi", "destination": "/rideemagi" },
    { "source": "/games/rideemagi/", "destination": "/rideemagi" },
    { "source": "/games/trenchingsimulator", "destination": "/trenchingsimulator" },
    { "source": "/games/trenchingsimulator/", "destination": "/trenchingsimulator" },
    { "source": "/games/vladrunner2049", "destination": "/vladrunner2049" },
    { "source": "/games/vladrunner2049/", "destination": "/vladrunner2049" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "studio.agi1.app" }], "destination": "/studio" }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "inference.agi1.app" }], "destination": "/cloakmesh", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "studio.agi1.app" }], "destination": "/explore", "permanent": false }
  ],
  "functions": {
    "api/feed.js": {
      "maxDuration": 25,
      "includeFiles": "node_modules/@ffmpeg-installer/linux-x64/**"
    },
    "api/**/*.js": {
      "maxDuration": 25
    }
  },
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 3 * * *" },
    { "path": "/api/keepalive", "schedule": "0 11 * * *" },
    { "path": "/api/keepalive", "schedule": "0 19 * * *" },
    { "path": "/api/feed", "schedule": "30 1 * * *" },
    { "path": "/api/feed", "schedule": "30 4 * * *" },
    { "path": "/api/feed", "schedule": "30 7 * * *" },
    { "path": "/api/feed", "schedule": "30 10 * * *" },
    { "path": "/api/feed", "schedule": "30 13 * * *" },
    { "path": "/api/feed", "schedule": "30 16 * * *" },
    { "path": "/api/feed", "schedule": "30 19 * * *" },
    { "path": "/api/feed", "schedule": "30 22 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://live.agi1.app; media-src 'self' blob:; connect-src 'self' blob: https://api.dexscreener.com wss://live.agi1.app; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), display-capture=(self)"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/cards/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/icons/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/music/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/theme.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
