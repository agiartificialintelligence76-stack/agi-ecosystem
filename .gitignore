# ── Secrets: never commit these ─────────────────────────────
.env
.env.*
!.env.example

# ── Vercel link: ties a folder to a Vercel project ──────────
# Never commit it, and NEVER copy it from AGI FINAL (a deploy
# from here would overwrite the live site).
.vercel/

# ── Installed packages and build output (npm re-creates them)
node_modules/
dist/

# ── Big original art files (only optimized copies go in git)
_source-assets/

# ── Junk from editors / operating systems ───────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
/tools/owner-qa/

# ── Copies of files Claude sent in chat (the Claude desktop app
#    saves them here). Not part of the site; may be out of date.
Claude outputs/

# The Telegram export AGI-1's group memory is built from (tools/memory/). Thousands of people's messages: never in git.
telegram memories/

# Covers and pictures for X posts about the site (not part of the website)
x-article/

# AGI-1's daily clips (tools/clips/make.mjs): the videos are made on GitHub's computer and downloaded from there
/clips/

# Her live show (tools/live/, 2026-10-02): her kept voice lines and the show's settings file on the owner's server (its
# secrets: LIVE_SECRET, the stream key, the Google Cloud key), and any Google Cloud key file. Never in git.
tools/live/cache/
tools/live/live.env
*.live.env
*-gcp-key.json
google-key.json

# Her launch video (tools/promo/make.mjs, 2026-10-03): the videos it makes (big files: the owner posts them by hand)
/promo/

# AGI Studio's launch video (tools/studio-promo/make.mjs, 2026-10-13): the videos it makes, and the example pictures
# and clips it shows (made ready once by tools/studio-promo/media.mjs: big files, never in git)
/studio-promo/
tools/studio-promo/media/

# The roadmap's video (tools/roadmap-promo/make.mjs, 2026-10-14): AGI-1's voice takes made ready once by
# tools/roadmap-promo/media.mjs (made from the owner's downloads: never in git). Its videos go to /promo/ (above).
tools/roadmap-promo/media/

# The memes' originals (2026-10-23): some are over GitHub's 100 MB limit. Their web copies are in public/memes/
# (tools/memes/encode.ps1); the originals stay on this computer only.
memess/

# SKYBREAK (2026-10-31): its own project (skybreak/, the owner's folder) reads its 3D files from public/games/skybreak/,
# which is also where the site serves them from. Only the files the game loads go in git and on the site
# (tools/games/import-skybreak.mjs: RUNTIME); the original 17.9 MB city export and the provenance records stay here.
public/games/skybreak/environment/launch-plaza.spz
public/games/skybreak/environment/launch-plaza-lods.json
public/games/skybreak/motions/provenance.json
